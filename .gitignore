documentation

# Example output tree: every test_data/ fixture run through husk (export +
# dump-chunks + husk-blp), so someone can actually open the results in
# Blender -- generated, never committed, same disposable-output convention
# every other generated-artifact entry in this file already follows.
/example_exports/
/corpus_reports/

# blp/ (Python, uv-managed) -- .venv/ and .pytest_cache/ already carry
# their own self-excluding .gitignore, these cover the rest.
__pycache__/
*.pyc
.claude

# tools/corpus_test.py's uv-managed venv (tqdm/rich) -- set up locally via
# `cd tools && uv venv venv && uv pip install --python venv/bin/python tqdm rich`,
# never committed.
/tools/venv/

*.txt
*.old*
*.json
*.csv
*.log