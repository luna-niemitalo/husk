build/
/.direnv/
/.reference/
test_data/
# why: worktrees link test_data to the main checkout's copy; a trailing-slash
# pattern matches only directories, so the symlink needs its own line
/test_data
reference/
/result
documentation

# Example output tree: every test_data/ fixture run through husk (export +
# dump-chunks + husk-blp), so someone can actually open the results in
# Blender -- generated, never committed, same disposable-output convention
# every other generated-artifact entry in this file already follows.
/example_exports/
/corpus_reports/
/trash/

/references/wow_materials/
/references/wow_shaders/

# blp/ (Python, uv-managed) -- .venv/ and .pytest_cache/ already carry
# their own self-excluding .gitignore, these cover the rest.
__pycache__/
*.pyc

# why: Claude Code local state, can hold secrets (~/.claude/rules/git-no-claude-dir.md)
.claude
# why: messages from other projects and Luna's inbox answers, ingested then pruned
# (worked_on_index DESIGN.md "Feedback")
feedback/

# tools/corpus_test.py's uv-managed venv (tqdm/rich) -- set up locally via
# `cd tools && uv venv venv && uv pip install --python venv/bin/python tqdm rich`,
# never committed.
/tools/venv/

*.txt
*.old*
*.json
# schema/ is the bundle format's definition, and effects/ and techniques/
# the effect and technique documents husk writes; none is generated output.
!/schema/*.schema.json
!/effects/*.json
!/techniques/*/*.json
*.jsonl
*.csv
*.log
*.env
*.blend
*.blend1

# Blender's own autosave-on-crash backup, one per .blend -- never the file
# actually referenced by anything, regenerated locally on every crash.
*.blend1

# Scratch render output from local render runs.
/out/

# Snapshot dump the removed playwright-mcp left behind; delete the
# directory, then this line.
/.playwright-mcp/
# why: the central flake update (update-flakes.nu) leaves flake.lock.bak
# beside each flake.lock it bumps (~/.claude/rules/gitignore-bak.md)
*.bak

# Machine-local paths and commands (development/REFERENCES.md).
/development/
reports