# Writes OUT: a C++ source holding every schema/*.schema.json, every
# effects/*.json and every techniques/<family>/<name>.json as a string, so
# the husk binary carries the format definition it validates against and
# the effect and technique documents it writes. Invoked at build time with
# -DSCHEMA_DIR, -DEFFECT_DIR, -DTECHNIQUE_DIR, -DOUT, -DNAMES, -DEFFECTS and
# -DTECHNIQUES (comma-separated, since a ;-list doesn't survive the build
# tool's shell).
string(REPLACE "," ";" NAMES "${NAMES}")
string(REPLACE "," ";" EFFECTS "${EFFECTS}")
string(REPLACE "," ";" TECHNIQUES "${TECHNIQUES}")
set(body "// Generated by cmake/embed_schemas.cmake from schema/ and effects/. Do not edit.\n")
string(APPEND body "#include \"bundle_schema_embedded.hpp\"\n\nnamespace husk::bundle_schema {\n\n")
string(APPEND body "const std::vector<EmbeddedSchema>& embeddedSchemas() {\n    static const std::vector<EmbeddedSchema> schemas = {\n")
foreach(name IN LISTS NAMES)
  file(READ "${SCHEMA_DIR}/${name}.schema.json" text)
  string(APPEND body "        {\"${name}\", R\"husk_schema(${text})husk_schema\"},\n")
endforeach()
string(APPEND body "    };\n    return schemas;\n}\n\n")
string(APPEND body "const std::vector<EmbeddedSchema>& embeddedEffects() {\n    static const std::vector<EmbeddedSchema> effects = {\n")
foreach(name IN LISTS EFFECTS)
  file(READ "${EFFECT_DIR}/${name}.json" text)
  string(APPEND body "        {\"${name}\", R\"husk_schema(${text})husk_schema\"},\n")
endforeach()
string(APPEND body "    };\n    return effects;\n}\n\n")
string(APPEND body "const std::vector<EmbeddedSchema>& embeddedTechniques() {\n    static const std::vector<EmbeddedSchema> techniques = {\n")
foreach(name IN LISTS TECHNIQUES)
  file(READ "${TECHNIQUE_DIR}/${name}.json" text)
  string(APPEND body "        {\"${name}\", R\"husk_schema(${text})husk_schema\"},\n")
endforeach()
string(APPEND body "    };\n    return techniques;\n}\n\n}  // namespace husk::bundle_schema\n")
file(WRITE "${OUT}" "${body}")
