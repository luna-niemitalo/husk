# Writes OUT: a C++ source holding every schema/*.schema.json as a string,
# so the husk binary carries the format definition it validates against.
# Invoked at build time with -DSCHEMA_DIR, -DOUT and -DNAMES (comma-separated,
# since a ;-list doesn't survive the build tool's shell).
string(REPLACE "," ";" NAMES "${NAMES}")
set(body "// Generated by cmake/embed_schemas.cmake from schema/. Do not edit.\n")
string(APPEND body "#include \"bundle_schema_embedded.hpp\"\n\nnamespace husk::bundle_schema {\n\n")
string(APPEND body "const std::vector<EmbeddedSchema>& embeddedSchemas() {\n    static const std::vector<EmbeddedSchema> schemas = {\n")
foreach(name IN LISTS NAMES)
  file(READ "${SCHEMA_DIR}/${name}.schema.json" text)
  string(APPEND body "        {\"${name}\", R\"husk_schema(${text})husk_schema\"},\n")
endforeach()
string(APPEND body "    };\n    return schemas;\n}\n\n}  // namespace husk::bundle_schema\n")
file(WRITE "${OUT}" "${body}")
