# Writes OUT: a C++ source holding every schema/*.schema.json and every
# effects/*.json as a string, so the husk binary carries the format
# definition it validates against and the effect documents it writes.
# Invoked at build time with -DSCHEMA_DIR, -DEFFECT_DIR, -DOUT, -DNAMES and
# -DEFFECTS (comma-separated, since a ;-list doesn't survive the build
# tool's shell).
string(REPLACE "," ";" NAMES "${NAMES}")
string(REPLACE "," ";" EFFECTS "${EFFECTS}")
set(body "// Generated by cmake/embed_schemas.cmake from schema/ and effects/. Do not edit.\n")
string(APPEND body "#include \"bundle_schema_embedded.hpp\"\n\nnamespace husk::bundle_schema {\n\n")
string(APPEND body "const std::vector<EmbeddedSchema>& embeddedSchemas() {\n    static const std::vector<EmbeddedSchema> schemas = {\n")
foreach(name IN LISTS NAMES)
  file(READ "${SCHEMA_DIR}/${name}.schema.json" text)
  string(APPEND body "        {\"${name}\", R\"husk_schema(${text})husk_schema\"},\n")
endforeach()
string(APPEND body "    };\n    return schemas;\n}\n\n")
string(APPEND body "const std::vector<EmbeddedSchema>& embeddedEffects() {\n    static const std::vector<EmbeddedSchema> effects = {\n")
foreach(name IN LISTS EFFECTS)
  file(READ "${EFFECT_DIR}/${name}.json" text)
  string(APPEND body "        {\"${name}\", R\"husk_schema(${text})husk_schema\"},\n")
endforeach()
string(APPEND body "    };\n    return effects;\n}\n\n}  // namespace husk::bundle_schema\n")
file(WRITE "${OUT}" "${body}")
