            "x-source": [{"table": "CreatureDisplayInfoOption", "column": "ChrCustomizationChoiceID"}, {"table": "CreatureDisplayInfo", "column": "ParticleColorID"}, {"derived": "appearance_file"}]
          }
        },
        "additionalProperties": false,
