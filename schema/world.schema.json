{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://husk.invalid/schema/world.schema.json",
  "title": "world",
  "description": "The root of a place: its tile grid, what it places off the grid, and what belongs to the place as a whole.",
  "x-status": "implemented",
  "type": "object",
  "properties": {
    "format": {
      "const": "husk-bundle",
      "description": "Identifies a husk document.",
      "x-layer": "contract"
    },
    "kind": {
      "const": "world",
      "description": "Document kind.",
      "x-layer": "contract"
    },
    "schema_version": {
      "const": "0.2.2",
      "description": "Version of the schema this document conforms to.",
      "x-layer": "contract"
    },
    "subject": {
      "$ref": "common.schema.json#/definitions/ref",
      "description": "The place.",
      "x-layer": "contract"
    },
    "space": {
      "$ref": "common.schema.json#/definitions/space",
      "description": "Units and axes of every value in the document.",
      "x-layer": "contract"
    },
    "provenance": {
      "$ref": "common.schema.json#/definitions/provenance",
      "description": "Who wrote it, when, from what.",
      "x-layer": "contract"
    },
    "definition": {
      "type": "object",
      "description": "A world defines nothing beyond its contents.",
      "properties": {},
      "additionalProperties": false,
      "x-layer": "definition"
    },
    "selection": {
      "type": "object",
      "description": "A world selects nothing.",
      "properties": {},
      "additionalProperties": false,
      "x-layer": "selection"
    },
    "references": {
      "type": "array",
      "description": "Other documents this one depends on.",
      "items": {
        "$ref": "common.schema.json#/definitions/reference",
        "description": "One dependency."
      },
      "x-layer": "contract"
    },
    "grid": {
      "type": "object",
      "description": "Tiles on a regular grid; a missing cell is a hole. Neighbours of cell (i, j) are cells (i +/- 1, j +/- 1).",
      "properties": {
        "origin": {
          "$ref": "common.schema.json#/definitions/vec3",
          "description": "Position of cell (0, 0)'s placement.",
          "x-unit": "yard"
        },
        "cell_size": {
          "type": "number",
          "description": "Edge length of a cell.",
          "x-unit": "yard"
        },
        "axis_i": {
          "$ref": "common.schema.json#/definitions/vec3",
          "description": "Unit direction of increasing i.",
          "x-unit": "1"
        },
        "axis_j": {
          "$ref": "common.schema.json#/definitions/vec3",
          "description": "Unit direction of increasing j.",
          "x-unit": "1"
        },
        "cells": {
          "type": "array",
          "description": "Present cells.",
          "items": {
            "type": "object",
            "description": "One grid cell.",
            "properties": {
              "i": {
                "type": "integer",
                "description": "Cell column."
              },
              "j": {
                "type": "integer",
                "description": "Cell row."
              },
              "tile": {
                "type": "integer",
                "minimum": 0,
                "description": "The tile model placed in the cell, at origin + (i * axis_i + j * axis_j) * cell_size.",
                "x-index-into": "/references"
              },
              "bounds_min": {
                "$ref": "common.schema.json#/definitions/vec3",
                "description": "Minimum corner of the box the tile's terrain surface and liquids occupy, world frame.",
                "x-unit": "yard"
              },
              "bounds_max": {
                "$ref": "common.schema.json#/definitions/vec3",
                "description": "Maximum corner of that box.",
                "x-unit": "yard"
              }
            },
            "additionalProperties": false,
            "required": [
              "i",
              "j",
              "tile",
              "bounds_min",
              "bounds_max"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "origin",
        "cell_size",
        "axis_i",
        "axis_j",
        "cells"
      ],
      "x-layer": "resource"
    },
    "placements": {
      "type": "array",
      "description": "Placement sets the world places directly, off the grid: a map-wide building, and the map's fog and particulate volumes as effect instances.",
      "items": {
        "type": "integer",
        "minimum": 0,
        "description": "A placement set document.",
        "x-index-into": "/references"
      },
      "x-layer": "resource"
    },
    "zones": {
      "type": "array",
      "description": "Named regions of the world, nested (a subzone lies in its parent), each as the grid cells it covers. A cell lists only the zone its surface lies directly in: a zone's whole extent is its own cells and its descendants'.",
      "items": {
        "type": "object",
        "description": "One zone.",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Display name; absent when the source names none."
          },
          "name_source": {
            "$ref": "common.schema.json#/definitions/ref/properties/name_source",
            "description": "Where the name came from. Present exactly when name is."
          },
          "parent": {
            "type": "integer",
            "minimum": 0,
            "description": "The zone this one lies in; absent for a top-level zone.",
            "x-index-into": "/zones"
          },
          "cells": {
            "type": "array",
            "description": "Cells part of whose surface lies directly in this zone. Empty for a zone whose ground is all subzones.",
            "items": {
              "type": "object",
              "description": "One covered cell.",
              "properties": {
                "i": {
                  "type": "integer",
                  "description": "Cell column."
                },
                "j": {
                  "type": "integer",
                  "description": "Cell row."
                },
                "coverage": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Fraction of the cell's surface lying directly in this zone.",
                  "x-unit": "1"
                }
              },
              "additionalProperties": false,
              "required": [
                "i",
                "j",
                "coverage"
              ]
            }
          },
          "source": {
            "type": "object",
            "description": "Source-specific raw values.",
            "properties": {
              "id": {
                "$ref": "common.schema.json#/definitions/identity",
                "description": "The source's own record of the zone."
              }
            },
            "additionalProperties": false,
            "required": [
              "id"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "cells",
          "source"
        ],
        "dependencies": {
          "name": [
            "name_source"
          ],
          "name_source": [
            "name"
          ]
        }
      },
      "x-layer": "resource"
    }
  },
  "required": [
    "format",
    "kind",
    "schema_version",
    "subject",
    "space",
    "provenance",
    "definition",
    "selection",
    "references",
    "grid",
    "placements"
  ],
  "additionalProperties": false
}
