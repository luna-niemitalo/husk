{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://husk.invalid/schema/world.schema.json",
  "title": "world",
  "description": "The root of a place: its tile grid, what it places off the grid, and what belongs to the place as a whole.",
  "x-status": "implemented",
  "type": "object",
  "properties": {
    "format": {
      "const": "husk-bundle",
      "description": "Identifies a husk document.",
      "x-layer": "contract"
    },
    "kind": {
      "const": "world",
      "description": "Document kind.",
      "x-layer": "contract"
    },
    "schema_version": {
      "const": "1.0.0",
      "description": "Version of the schema this document conforms to.",
      "x-layer": "contract"
    },
    "subject": {
      "$ref": "common.schema.json#/definitions/ref",
      "description": "The place.",
      "x-layer": "contract"
    },
    "space": {
      "$ref": "common.schema.json#/definitions/space",
      "description": "Units and axes of every value in the document.",
      "x-layer": "contract"
    },
    "provenance": {
      "$ref": "common.schema.json#/definitions/provenance",
      "description": "Who wrote it, when, from what.",
      "x-layer": "contract"
    },
    "definition": {
      "type": "object",
      "description": "A world defines nothing beyond its contents.",
      "properties": {},
      "additionalProperties": false,
      "x-layer": "definition"
    },
    "selection": {
      "type": "object",
      "description": "A world selects nothing.",
      "properties": {},
      "additionalProperties": false,
      "x-layer": "selection"
    },
    "references": {
      "type": "array",
      "description": "Other documents this one depends on.",
      "items": {
        "$ref": "common.schema.json#/definitions/reference",
        "description": "One dependency."
      },
      "x-layer": "contract"
    },
    "grid": {
      "type": "object",
      "description": "Tiles on a regular grid; a missing cell is a hole. Neighbours of cell (i, j) are cells (i +/- 1, j +/- 1).",
      "properties": {
        "origin": {
          "$ref": "common.schema.json#/definitions/vec3",
          "description": "Position of cell (0, 0)'s placement.",
          "x-unit": "yard"
        },
        "cell_size": {
          "type": "number",
          "description": "Edge length of a cell.",
          "x-unit": "yard"
        },
        "axis_i": {
          "$ref": "common.schema.json#/definitions/vec3",
          "description": "Unit direction of increasing i.",
          "x-unit": "1"
        },
        "axis_j": {
          "$ref": "common.schema.json#/definitions/vec3",
          "description": "Unit direction of increasing j.",
          "x-unit": "1"
        },
        "cells": {
          "type": "array",
          "description": "Present cells.",
          "items": {
            "type": "object",
            "description": "One grid cell.",
            "properties": {
              "i": {
                "type": "integer",
                "description": "Cell column."
              },
              "j": {
                "type": "integer",
                "description": "Cell row."
              },
              "tile": {
                "type": "integer",
                "minimum": 0,
                "description": "The tile model placed in the cell, at origin + (i * axis_i + j * axis_j) * cell_size.",
                "x-index-into": "/references"
              },
              "bounds_min": {
                "$ref": "common.schema.json#/definitions/vec3",
                "description": "Minimum corner of the box the tile's terrain surface and liquids occupy, world frame.",
                "x-unit": "yard"
              },
              "bounds_max": {
                "$ref": "common.schema.json#/definitions/vec3",
                "description": "Maximum corner of that box.",
                "x-unit": "yard"
              }
            },
            "additionalProperties": false,
            "required": [
              "i",
              "j",
              "tile",
              "bounds_min",
              "bounds_max"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "origin",
        "cell_size",
        "axis_i",
        "axis_j",
        "cells"
      ],
      "x-layer": "resource"
    },
    "placements": {
      "type": "array",
      "description": "Placement sets the world places directly, off the grid: a map-wide building, and the map's fog and particulate volumes as effect instances.",
      "items": {
        "type": "integer",
        "minimum": 0,
        "description": "A placement set document.",
        "x-index-into": "/references"
      },
      "x-layer": "resource"
    }
  },
  "required": [
    "format",
    "kind",
    "schema_version",
    "subject",
    "space",
    "provenance",
    "definition",
    "selection",
    "references",
    "grid",
    "placements"
  ],
  "additionalProperties": false
}
