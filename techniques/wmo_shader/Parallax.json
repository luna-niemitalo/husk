      },
      "uv1": {
        "kind": "vertex_value",
        "description": "The uv1 the vertex shader generates for this draw (its uv mode, cb2[1]) unless the draw's environment-mapping flag (cb0[5].y = 1 or 2) replaces it with sphere-mapped coordinates."
      },
      "uv2": {
        "kind": "vertex_value",
        "description": "The uv2 the vertex shader generates for this draw (its uv mode, cb2[1])."
      },
      "reflect_xy": {
        "kind": "renderer_value",
        "status": "described",
        "description": "reflect(V, N).xy = (V - 2*dot(V, N)*N).xy, the raw x and y used as a coordinate (not sphere-mapped), with V = normalize(view-space position) and N the view-space normal; the vertex shader computes it per vertex."
      },
      "tangent_view": {
        "kind": "renderer_value",
        "status": "described",
        "description": "The view direction in a tangent frame built from screen derivatives of uv1 (two components): with P the view-space position, N the view-space normal, V = normalize(P), dp1 = ddx(P), dp2 = ddy(P), du1 = ddx(uv1), du2 = ddy(uv1) (coarse derivatives), T = cross(dp2, N)*du1.x + cross(N, dp1)*du2.x and B = cross(dp2, N)*du1.y + cross(N, dp1)*du2.y, both divided by sqrt(max(dot(T, T), dot(B, B))): (dot(T, V), dot(B, V)) / dot(N, V). It needs screen derivatives, so the renderer computes it."
      },
      "v3w": {
        "kind": "vertex_value",
        "description": "The second vertex colour's alpha (v3.w)."
      }
    },
